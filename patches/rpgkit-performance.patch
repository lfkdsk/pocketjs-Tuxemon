+import { describe, expect, test } from "bun:test";
+import { activePage, createSwitchState } from "../src/engine/interpreter.ts";
+import { createExtensionRuntime } from "../src/engine/extensions.ts";
+import type { SessionState } from "../src/engine/session.ts";
+import type { GameEvent, PageCondition } from "../src/engine/types.ts";
+import { npcArtInputs } from "../src/ui/npc-art-inputs.ts";
+
+const state = (): SessionState => ({ mapId: "map", sw: createSwitchState(), move: { facing: 0 }, ext: null } as SessionState);
+const event = (condition: PageCondition): GameEvent => ({ id: "npc", x: 0, y: 0, pages: [
+  { trigger: "action", sprite: "base", commands: [] },
+  { trigger: "action", sprite: "changed", commands: [], condition },
+] });
+
+describe("NPC art condition inputs", () => {
+  const cases: [PageCondition, (s: SessionState) => void][] = [
+    [{ switch: "gate" }, s => { s.sw.switches.gate = true; }],
+    [{ variable: { id: "shown", op: "==", value: 1 } }, s => { s.sw.variables.shown = 1; }],
+    [{ selfSwitch: "A" }, s => { s.sw.self["map/npc"] = "A"; }],
+    [{ item: "key" }, s => { s.sw.items.key = 1; }],
+    [{ all: [{ kind: "switch", id: "gate" }] }, s => { s.sw.switches.gate = true; }],
+    [{ all: [{ kind: "variable", id: "shown", op: "==", value: 1 }] }, s => { s.sw.variables.shown = 1; }],
+    [{ all: [{ kind: "selfSwitch", key: "A" }] }, s => { s.sw.self["map/npc"] = "A"; }],
+    [{ all: [{ kind: "item", id: "key", count: 2 }] }, s => { s.sw.items.key = 2; }],
+    [{ all: [{ kind: "gold", amount: 2 }] }, s => { s.sw.gold = 2; }],
+    [{ all: [{ kind: "facing", dir: "right" }] }, s => { s.move.facing = 3; }],
+  ];
+  for (const [condition, change] of cases) test(`tracks ${JSON.stringify(condition)}`, () => {
+    const ev = event(condition), read = npcArtInputs([ev], "map"), before = state(), after = state();
+    const original = read(before, false);
+    change(after);
+    expect(activePage(ev, before.sw, "map", before.move.facing)?.index).toBe(0);
+    expect(activePage(ev, after.sw, "map", after.move.facing)?.index).toBe(1);
+    expect(read(after, false)).not.toEqual(original);
+    expect(read(before, false)).toEqual(original);
+  });
+
+  test("unrelated variables, movement and dialogue idle changes leave actor inputs unchanged", () => {
+    const ev = event({ variable: { id: "shown", op: "==", value: 1 } });
+    const read = npcArtInputs([ev], "map"), s = state(), before = read(s, true);
+    s.sw.variables = { unrelated: 4 };
+    s.move.facing = 2; s.ext = "unrelated";
+    expect(read(s, false)).toEqual(before);
+    s.sw.variables = { shown: 1, unrelated: 4 };
+    expect(read(s, false)).not.toEqual(before);
+  });
+
+  test("world idle and event self-switch keys are explicit inputs", () => {
+    const s = state(), idle = npcArtInputs([event({ all: [{ kind: "worldIdle" }] })], "map");
+    expect(idle(s, false)).not.toEqual(idle(s, true));
+    const self = npcArtInputs([event({ selfSwitch: "A" })], "map"), before = self(s, false);
+    s.sw.self["other/npc"] = "A";
+    expect(self(s, false)).toEqual(before);
+    s.sw.self["map/npc"] = "A";
+    expect(self(s, false)).not.toEqual(before);
+  });
+
+  test("extension pages retain complete bank and extension dependencies", () => {
+    const ev = event({ all: [{ kind: "ext", call: "game.visible", args: null }] });
+    const read = npcArtInputs([ev], "map"), before = state(), after = state();
+    const runtime = createExtensionRuntime({ immutableConditions: true, deterministicConditions: true,
+      conditions: { "game.visible": c => c.ext === "shown" && c.variables.flag === 1 && c.gold > 0 } });
+    after.ext = "shown"; after.sw.variables.flag = 1; after.sw.gold = 2;
+    expect(read(after, false)).not.toEqual(read(before, false));
+    expect(activePage(ev, before.sw, "map", 0, { runtime, ext: before.ext })?.index).toBe(0);
+    expect(activePage(ev, after.sw, "map", 0, { runtime, ext: after.ext })?.index).toBe(1);
+  });
+
+  test("inherited bank keys cannot select a page or change its inputs", () => {
+    const ev = event({ switch: "gate" }), read = npcArtInputs([ev], "map"), s = state();
+    const before = read(s, false);
+    s.sw.switches = Object.create({ gate: true });
+    expect(read(s, false)).toEqual(before);
+    expect(activePage(ev, s.sw, "map")?.index).toBe(0);
+    s.sw.switches.gate = true;
+    expect(read(s, false)).not.toEqual(before);
+    expect(activePage(ev, s.sw, "map")?.index).toBe(1);
+  });
+});
