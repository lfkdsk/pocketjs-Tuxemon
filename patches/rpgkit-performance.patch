--- /dev/null
+++ b/src/ui/npc-art-inputs.ts
@@ -0,0 +1,46 @@
+import type { SessionState } from "../engine/session.ts";
+import type { GameEvent } from "../engine/types.ts";
+
+/** Inputs read by the visible actors' page conditions. Invisible event pages
+ * do not select actor art; movement clocks do not select it either. */
+export function npcArtInputs(events: readonly GameEvent[], mapId: string) {
+  const switches = new Set<string>(), variables = new Set<string>();
+  const self = new Set<string>(), items = new Set<string>();
+  let gold = false, facing = false, worldIdle = false, extension = false;
+  for (const ev of events) for (const page of ev.pages) {
+    const c = page.condition;
+    if (!c) continue;
+    if (c.switch !== undefined) switches.add(c.switch);
+    if (c.variable) variables.add(c.variable.id);
+    if (c.selfSwitch !== undefined) self.add(`${mapId}/${ev.id}`);
+    if (c.item !== undefined) items.add(c.item);
+    for (const clause of c.all ?? []) switch (clause.kind) {
+      case "switch": switches.add(clause.id); break;
+      case "variable": variables.add(clause.id); break;
+      case "selfSwitch": self.add(`${mapId}/${ev.id}`); break;
+      case "item": items.add(clause.id); break;
+      case "gold": gold = true; break;
+      case "facing": facing = true; break;
+      case "worldIdle": worldIdle = true; break;
+      case "ext": extension = true; break;
+    }
+  }
+  // An opaque extension condition retains the previous broad invalidation
+  // context, including inputs not exposed through its read-context object.
+  if (extension) return (state: SessionState, idle: boolean): readonly unknown[] => [
+    state.mapId, state.sw.switches, state.sw.self, state.sw.variables,
+    state.sw.items, state.sw.gold, state.ext, state.move.facing, idle,
+  ];
+  const reads = [["switches", [...switches]], ["variables", [...variables]],
+    ["self", [...self]], ["items", [...items]]] as const;
+  return (state: SessionState, idle: boolean): readonly unknown[] => {
+    const values: unknown[] = [state.mapId];
+    for (const [bank, keys] of reads) {
+      for (const key of keys) values.push(Object.hasOwn(state.sw[bank], key) ? state.sw[bank][key] : undefined);
+    }
+    if (gold) values.push(state.sw.gold);
+    if (facing) values.push(state.move.facing);
+    if (worldIdle) values.push(idle);
+    return values;
+  };
+}
